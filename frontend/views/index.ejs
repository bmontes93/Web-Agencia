<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head', { title: 'Agencia de Crecimiento Digital' }) %>
</head>
<body>

    <%- include('partials/header') %>

    <main>
        <!-- 1. Sección Hero -->
        <section class="fade-in-section hero">
            <h1>Escalamos tu Negocio con Estrategias de Crecimiento Digital Basadas en Datos</h1>
            <p>Ayudamos a empresas B2B y SaaS a multiplicar su MRR a través de SEO, Contenido y Analítica Avanzada.</p>
            <a href="/contacto" class="cta-principal">Agendar una Sesión Estratégica</a>
            <div class="hero-visual">
                <div class="carousel-container">
                    <div class="carousel-slide">
                        <img data-src="/images/optimized/caso1.webp" alt="Imagen de estrategia de crecimiento digital" loading="lazy">
                        <img data-src="/images/optimized/caso2.webp" alt="Imagen de análisis de datos de marketing" loading="lazy">
                        <img data-src="/images/optimized/caso3.webp" alt="Imagen de optimización de conversión" loading="lazy">
                    </div>
                    <button class="carousel-button prev">&#10094;</button>
                    <button class="carousel-button next">&#10095;</button>
                    <div class="carousel-dots"></div>
                </div>
            </div>
        </section>

        <!-- Prueba Social -->
        <section class="fade-in-section social-proof">
            <h2>Con la confianza de empresas líderes</h2>
            <div class="logos-clientes">
                <img data-src="/images/optimized/logo-cliente-1.webp" alt="Logo de Cliente 1" loading="lazy">
                <img data-src="/images/optimized/logo-cliente-2.webp" alt="Logo de Cliente 2" loading="lazy">
                <img data-src="/images/optimized/logo-cliente-3.webp" alt="Logo de Cliente 3" loading="lazy">
            </div>
            <div class="testimonios-cortos">
                <blockquote>"Trabajar con esta agencia ha transformado nuestra estrategia digital. ¡Resultados impresionantes!" - CEO, Tech Solutions Inc.</blockquote>
            </div>
        </section>

        <!-- 2. Sección de Servicios (Resumen) -->
        <section class="fade-in-section servicios-resumen">
            <h2>Nuestros Servicios</h2>
            <div class="servicios-grid">
                <div class="servicio-item">
                    <h3>SEO Técnico</h3>
                    <p>Optimizamos la estructura de tu web para que los motores de búsqueda te amen.</p>
                    <a href="/servicios/seo">Ver más</a>
                </div>
                <div class="servicio-item">
                    <h3>Marketing de Contenidos</h3>
                    <p>Creamos contenido que atrae, educa y convierte a tu audiencia ideal.</p>
                    <a href="/servicios/marketing-contenidos">Ver más</a>
                </div>
                <div class="servicio-item">
                    <h3>Pauta Digital (PPC)</h3>
                    <p>Campañas de pago por clic enfocadas en maximizar tu retorno de inversión.</p>
                    <a href="/servicios/pauta-digital">Ver más</a>
                </div>
                <div class="servicio-item">
                    <h3>Analítica y CRO</h3>
                    <p>Convertimos datos en decisiones y optimizamos tu tasa de conversión.</p>
                    <a href="/servicios/analitica-cro">Ver más</a>
                </div>
            </div>
        </section>

        <!-- 3. Presentación de tu Diferencial -->
        <section class="fade-in-section diferencial">
            <h2>¿Por Qué Elegirnos?</h2>
            <p>Nuestra metodología única se centra en la toma de decisiones basada en datos para garantizar resultados medibles y sostenibles. Nos integramos como una extensión de tu equipo.</p>
            <!-- Infografía o diagrama puede ir aquí -->
        </section>

        <!-- 4. Casos de Éxito Destacados -->
        <section class="fade-in-section casos-exito-destacados">
            <h2>Nuestros Resultados</h2>
            <div class="casos-grid">
                <div class="caso-item">
                    <img data-src="/images/optimized/caso1.webp" alt="Imagen del caso de éxito 1" loading="lazy">
                    <h3>Cliente A: +150% en Tráfico Orgánico</h3>
                    <p>Incremento logrado en 6 meses a través de una estrategia de contenido y SEO técnico.</p>
                    <a href="/casos-de-exito/caso-1">Leer caso de estudio</a>
                </div>
                <div class="caso-item">
                    <img data-src="/images/optimized/caso2.webp" alt="Imagen de un proyecto de reducción de CPA" loading="lazy">
                    <h3>Cliente B: Reducción del 50% en CPA</h3>
                    <p>Optimización de campañas de Google Ads y Social Ads para mejorar la eficiencia.</p>
                    <a href="/casos-de-exito/caso-2">Leer caso de estudio</a>
                </div>
            </div>
        </section>

        <!-- 5. Sección de Recursos (Blog) -->
        <section class="fade-in-section recursos-recientes">
            <h2>De Nuestro Blog</h2>
            <div class="articulos-grid">
                <article>
                    <h3><a href="/recursos/articulo-1">Título del Artículo 1</a></h3>
                    <p>Un breve extracto del artículo para enganchar al lector...</p>
                </article>
                <article>
                    <h3><a href="/recursos/articulo-2">Título del Artículo 2</a></h3>
                    <p>Un breve extracto del artículo para enganchar al lector...</p>
                </article>
                <article>
                    <h3><a href="/recursos/articulo-3">Título del Artículo 3</a></h3>
                    <p>Un breve extracto del artículo para enganchar al lector...</p>
                </article>
            </div>
        </section>

        <!-- 6. Llamada a la Acción (CTA) Final -->
        <section class="fade-in-section cta-final">
            <h2>¿Listo para Hacer Crecer tu Negocio?</h2>
            <p>Hablemos sobre tus objetivos y cómo podemos ayudarte a alcanzarlos.</p>
            <a href="/contacto" class="cta-principal">Agendar una Sesión Estratégica</a>
        </section>
    </main>

    <%- include('partials/footer') %>

</body>
</html>