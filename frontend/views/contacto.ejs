<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head', { title: 'Contacto - Agencia de Crecimiento Digital' }) %>
</head>
<body>

    <%- include('partials/header') %>

    <main>
        <section class="fade-in-section page-title">
            <h1>Hablemos</h1>
            <p>Estamos aquí para responder a tus preguntas y listos para ayudarte a alcanzar tus objetivos. Rellena el formulario o contáctanos directamente.</p>
        </section>

        <section class="fade-in-section contact-section">
            <div class="contact-layout">
                <div class="contact-form">
                    <form id="contact-form">
                        <div class="form-group">
                            <label for="name">Nombre Completo</label>
                            <input type="text" id="name" name="name" required>
                        </div>
                        <div class="form-group">
                            <label for="email">Email</label>
                            <input type="email" id="email" name="email" required>
                        </div>
                        <div class="form-group">
                            <label for="company">Empresa</label>
                            <input type="text" id="company" name="company">
                        </div>
                        <div class="form-group">
                            <label for="message">¿Cómo podemos ayudarte?</label>
                            <textarea id="message" name="message" rows="6" required></textarea>
                        </div>
                        <button type="submit" class="cta-principal" style="width: 100%;">Enviar Mensaje</button>
                    </form>
                    <div id="form-message" style="margin-top: 20px;"></div>
                </div>
                <div class="contact-info">
                    <h3>Información Directa</h3>
                    <p>
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                        info@agenciadigital.com
                    </p>
                    <p>
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.63A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                        +123 456 7890
                    </p>
                    
                    <h3>Horario de Atención</h3>
                    <p>Lunes a Viernes<br>9:00 AM - 6:00 PM</p>

                    <h3>Síguenos</h3>
                    <!-- Social links here -->
                    <div id="map" style="height: 300px; width: 100%; margin-top: 20px;"></div>
                </div>
            </div>
        </section>

    </main>

    <%- include('partials/footer') %>

    <script async defer src="https://maps.googleapis.com/maps/api/js?key=<%= googleMapsApiKey %>&callback=initMap"></script>
</body>
</html>